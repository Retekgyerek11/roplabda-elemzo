// ════════════════════════════════════════════════════════════════════
// Röplabda Meccs Elemző — Realtime Database hozzáférési szabályok
//
// Firebase konzol > Realtime Database > Rules fül > bemásol > Publish
//
// A fő admin e-mail címe több helyen szerepel. Ha megváltozik, cseréld
// mindenhol, és ugyanezt írd át az app.js-ben az ADMIN_EMAIL sorban is.
// ════════════════════════════════════════════════════════════════════
{
  "rules": {

    "users": {
      // A teljes listát csak admin olvashatja; mindenki más kizárólag
      // a saját rekordját (ebből derül ki, mely ligákhoz van joga).
      ".read": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'leiner.peter11@gmail.com')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'leiner.peter11@gmail.com')",

      "$uid": {
        ".read": "auth != null && auth.uid === $uid",

        // A belépés időbélyegét mindenki a sajátjára írhatja.
        "lastLogin": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "matchIndex": {
      // A meccsek listája metaadatokkal (dátum, csapatok, verseny, eredmény).
      // Ez tölt be először, ebből épül a csapatválasztó és a szűrők — nyers
      // fájl letöltése nélkül. Enélkül az ág nélkül semmi nem jelenik meg.
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() !== false",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'leiner.peter11@gmail.com')"
    },

    "matches": {
      // Minden aktív, bejelentkezett felhasználó olvashat; feltölteni
      // és törölni csak admin tud.
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() !== false",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'leiner.peter11@gmail.com')"
    },

    "leagues": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'leiner.peter11@gmail.com')"
    },

    "matchLeagues": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'leiner.peter11@gmail.com')"
    },

    "manualDates": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'leiner.peter11@gmail.com')"
    },

    "matchdayNotes": {
      // Útvonal: liga / csapat / felhasználó-azonosító.
      // Mindenki csak a sajátját írja, és csak a sajátját olvassa.
      // Az admin mindet elolvashatja, de írni ő is csak a sajátját tudja.
      "$league": {
        "$team": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'leiner.peter11@gmail.com')",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "reports": {
      // A csapatnak megosztott meccslap-link — szándékosan bejelentkezés
      // nélkül olvasható, hogy a játékosok telefonon megnyithassák.
      // Írni és törölni csak bejelentkezve lehet. A linkek 5 nap után
      // lejárnak: a lejárt riportokat az alkalmazás takarítja ki
      // publikáláskor, a megnyitást pedig az expiresAt mező tiltja.
      ".read": true,
      "$id": {
        ".write": "auth != null"
      }
    },

    // Bármi más, ami nincs fent felsorolva, alapból tiltott.
    ".read": false,
    ".write": false
  }
}
